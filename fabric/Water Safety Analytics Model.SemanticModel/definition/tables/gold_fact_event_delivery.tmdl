table gold_fact_event_delivery
	lineageTag: cfd4aab5-3ae8-40a2-a7dd-35c67f186de4
	sourceLineageTag: [dbo].[gold_fact_event_delivery]

	measure 'Total Delivery Records' = SUM ( gold_fact_event_delivery[delivery_count] )
		formatString: 0
		displayFolder: 01 - Core KPIs
		lineageTag: 808f577a-b7cb-4e87-9516-cc2162706ca2

		changedProperty = Name

		changedProperty = DisplayFolder

	/// Distinct count of overall events or campaigns. Multi-day activities are counted once.
	measure 'Total Event Groups' = DISTINCTCOUNT ( gold_fact_event_delivery[event_group_id] )
		formatString: 0
		displayFolder: 01 - Core KPIs
		lineageTag: 36d7de02-d74e-43d8-ab41-aa7559ee7dc6

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

	measure 'Total People Reached' = SUM ( gold_fact_event_delivery[people_reached] )
		formatString: #,0
		displayFolder: 01 - Core KPIs
		lineageTag: 946d4541-adc7-447d-b1a8-47b34f1573db

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Total Registered' = SUM ( gold_fact_event_delivery[registered_count] )
		formatString: 0
		displayFolder: 01 - Core KPIs
		lineageTag: ac735fcd-5104-4e22-ace0-539164bc586f

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Total Attended' = SUM ( gold_fact_event_delivery[attended_count] )
		formatString: 0
		displayFolder: 01 - Core KPIs
		lineageTag: 9adad899-88b7-4a71-a181-e495519697b1

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Registered Event Attended' =
			
			CALCULATE (
			    [Total Attended],
			    gold_fact_event_delivery[registered_count] <> BLANK()
			)
		formatString: 0
		displayFolder: 02 - Attendance
		lineageTag: 6caeb42e-c73f-4d90-89f0-619f57ec7b4a

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Attendance Variance' = [Registered Event Attended] - [Total Registered]
		formatString: 0
		displayFolder: 02 - Attendance
		lineageTag: a756af40-b715-4b9c-89e7-d802c2fa103c

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Attendance Rate' =
			
			DIVIDE (
			    [Registered Event Attended],
			    [Total Registered]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 - Attendance
		lineageTag: 0462774c-5265-463a-827d-6b2576a28a0a

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Average Satisfaction' =
			
			AVERAGE (
			    gold_fact_event_delivery[satisfaction_score]
			)
		formatString: 0.00
		displayFolder: 03 - Satisfaction
		lineageTag: 2d0ce893-2e5f-4d86-a818-04924da615a8

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Rated Delivery Records' =
			
			CALCULATE (
			    [Total Delivery Records],
			    gold_fact_event_delivery[satisfaction_score] <> BLANK()
			)
		formatString: 0
		displayFolder: 03 - Satisfaction
		lineageTag: a866cef3-b456-4575-b551-891270738a10

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Total Session Hours' =
			
			SUM (
			    gold_fact_event_delivery[session_duration_hours]
			)
		formatString: 0.0
		displayFolder: 05 - Time & Outreach
		lineageTag: 96f0f0e1-bcd5-4460-8610-a4552c46fcea

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Average People Reached per Delivery' =
			
			DIVIDE (
			    [Total People Reached],
			    [Total Delivery Records]
			)
		formatString: 0.0
		displayFolder: 05 - Time & Outreach
		lineageTag: 3899bb6c-7322-4bda-99be-04a3f2350df8

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Locations Reached' =
			
			DISTINCTCOUNT (
			    gold_fact_event_delivery[location_id]
			)
		formatString: 0
		displayFolder: 05 - Time & Outreach
		lineageTag: 0d96264a-eaa1-4c7a-8a98-9407b2eae189

		changedProperty = Name

		changedProperty = DisplayFolder

